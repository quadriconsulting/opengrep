{
  "sql_injection_patterns": {
    "python": [
      {
        "name": "format_string_sql",
        "pattern": "cursor\\.execute\\(f[\"'].*?\\{.*?\\}.*?[\"']\\)",
        "fix_template": "cursor.execute(\"{{QUERY}}\", ({{PARAMS}},))",
        "confidence": "HIGH",
        "description": "Replace f-string SQL with parameterized queries"
      },
      {
        "name": "concatenated_sql",
        "pattern": "cursor\\.execute\\(.*?\\+.*?\\)",
        "fix_template": "cursor.execute(\"{{QUERY}}\", {{PARAMS}})",
        "confidence": "HIGH",
        "description": "Replace string concatenation with parameterized queries"
      },
      {
        "name": "percent_format_sql",
        "pattern": "cursor\\.execute\\(.*?%.*?%.*?\\)",
        "fix_template": "cursor.execute(\"{{QUERY}}\", {{PARAMS}})",
        "confidence": "MEDIUM",
        "description": "Replace % formatting with parameterized queries"
      }
    ],
    "javascript": [
      {
        "name": "template_literal_sql",
        "pattern": "query\\s*=\\s*`.*?\\$\\{.*?\\}.*?`",
        "fix_template": "query = \"{{QUERY}}\"; params = [{{PARAMS}}]",
        "confidence": "HIGH",
        "description": "Replace template literals with parameterized queries"
      },
      {
        "name": "concatenated_sql_js",
        "pattern": "query\\s*=\\s*.*?\\+.*?",
        "fix_template": "query = \"{{QUERY}}\"; params = [{{PARAMS}}]", 
        "confidence": "MEDIUM",
        "description": "Replace string concatenation with parameterized queries"
      }
    ],
    "java": [
      {
        "name": "statement_execute_query",
        "pattern": "statement\\.executeQuery\\(.*?\\+.*?\\)",
        "fix_template": "PreparedStatement pstmt = connection.prepareStatement(\"{{QUERY}}\"); pstmt.setString(1, {{PARAM}}); pstmt.executeQuery()",
        "confidence": "HIGH",
        "description": "Replace Statement with PreparedStatement"
      }
    ]
  },
  
  "xss_patterns": {
    "javascript": [
      {
        "name": "innerHTML_assignment",
        "pattern": "\\.innerHTML\\s*=\\s*.*?",
        "fix_template": ".textContent = {{VALUE}} // or use DOMPurify.sanitize({{VALUE}})",
        "confidence": "MEDIUM",
        "description": "Replace innerHTML with textContent or sanitization"
      },
      {
        "name": "document_write",
        "pattern": "document\\.write\\(.*?\\)",
        "fix_template": "// Use safe DOM manipulation instead of document.write",
        "confidence": "HIGH",
        "description": "Avoid document.write for dynamic content"
      }
    ],
    "python": [
      {
        "name": "render_template_string",
        "pattern": "render_template_string\\(f[\"'].*?\\{.*?\\}.*?[\"'].*?\\)",
        "fix_template": "render_template_string(\"{{TEMPLATE}}\", {{CONTEXT}})",
        "confidence": "MEDIUM",
        "description": "Use proper template context instead of f-strings"
      },
      {
        "name": "format_in_template",
        "pattern": "\\.format\\(.*?request\\.",
        "fix_template": "# Use template context: render_template('template.html', data={{DATA}})",
        "confidence": "MEDIUM",  
        "description": "Avoid string formatting with user input in templates"
      }
    ]
  },
  
  "crypto_weakness_patterns": {
